# Server Configuration
# Bind the API to loopback unless a firewall already limits the port.
# Set HOST=0.0.0.0 only when the process must accept remote connections directly.
PORT=3000
HOST=127.0.0.1
FRONTEND_URL=http://localhost:5173

# Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For.
# Leave unset or false when the Node process is directly reachable.
TRUST_PROXY=false

# Anthropic API
# Get your API key from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard
# The API refuses to start without a real service-role key. It does not fall back to the anon key.
# Do not put the service-role key in any VITE_ variable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Secret for authentication
# Generate a strong random string for production (at least 32 characters).
# Sessions last 1 day. Example placeholders are rejected at startup.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# Server secret for AI routes and server-issued XP/badge awards.
# Send it as the x-ai-server-secret header. At least 32 characters.
# Leave unset to require a logged-in user for AI routes and to reject
# client calls to /api/gamification/xp/award and /api/gamification/badges/award.
# Never put this value in frontend code.
AI_SERVER_SECRET=
